[Unit]
Description=Rewards health API
After=network-online.target
Wants=network-online.target

[Service]
User=rewards
Group=rewards
EnvironmentFile=/etc/rewards-api/environment
ExecStart=/usr/bin/python3 /opt/rewards-api/app.py
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
